# URL base da API do backend (NestJS), incluindo o prefixo global /v1.
NEXT_PUBLIC_API_URL=http://localhost:5000/v1

# Segredo usado para validar o JWT no middleware (src/middleware.ts).
# DEVE ser exatamente o mesmo valor de JWT_SECRET do notelab-backend.
JWT_SECRET=use-the-same-value-in-frontend-and-backend
